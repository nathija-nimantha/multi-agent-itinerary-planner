# Which family runs the graph: "gemini" (default) or "anthropic"
MODEL_PROVIDER=gemini

# Provider credentials — only the active provider's key is required.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings for retrieval. Required either way: Anthropic has no embeddings API.
OPENAI_API_KEY=

# Optional per-tier overrides, e.g. MODEL_REASONING=gemini-3.1-pro-preview
# MODEL_REASONING=
# MODEL_WORKER=
# MODEL_BULK=
